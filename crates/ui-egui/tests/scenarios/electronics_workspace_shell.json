[
  {"note":"Electronics opens from the workspace switcher as a flat page with no tabs and no History, and goes back to Design."},
  {"call":"ui.resize","params":{"width":1440,"height":1000}},
  {"call":"engine.execute","params":{"command":"solid.box","params":{"length":20,"width":15,"height":10}}},
  {"click":{"handle":"ribbon:workspace"}},
  {"click":{"handle":"workspace:menu:electronics"}},
  {"expect":{"shown_handles":["electronics:page","ribbon:workspace","ribbon:search"],"hidden_handles":["tab:MODEL","tab:SHEET METAL"],"errors":0}},
  {"call":"engine.execute","params":{"command":"ecad.inspect","params":{}}},
  {"expect":{"shown_handles":["electronics:page"],"hidden_handles":["tab:MODEL"],"errors":0}},
  {"call":"ui.set","params":{"layout":"docked"}},
  {"expect":{"shown_handles":["electronics:page","ribbon:workspace"],"hidden_handles":["tab:MODEL"],"errors":0}},
  {"call":"ui.workspace","params":{"workspace":"design"}},
  {"expect":{"shown_handles":["tab:MODEL"],"hidden_handles":["electronics:page"],"errors":0}}
]
